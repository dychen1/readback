#!/bin/zsh

set -euo pipefail

script_dir="${0:A:h}"
project_dir="${script_dir:h}"
assets_root="${READBACK_RELEASE_ASSETS_DIR:-${project_dir}/models}"
model_revision="a71e4d38b236d968966a2002c4c895dbd12b1c3c"
g2p_revision="9c692b92682d959d9013a9cfe6a49541997add18"
lexicon_revision="a3d069caea9a2b63daed40834514431f73a2f11e"
mlx_metal_sha256="70741174131dbf7fdd479cb730e06e08c358eac3bf7905d9e884e7960cfdd5b8"
model_dir="${assets_root}/Kokoro-82M-bf16"
languages_dir="${assets_root}/Languages"
mlx_dir="${assets_root}/MLX/0.31.1"
work_dir="$(mktemp -d)"

trap 'rm -rf "${work_dir}"' EXIT

fetch() {
    local source_url="$1"
    local destination="$2"
    if [[ -s "${destination}" ]]; then
        return
    fi
    mkdir -p "${destination:h}"
    curl -fL --retry 3 --output "${work_dir}/download" "${source_url}"
    mv "${work_dir}/download" "${destination}"
}

model_base="https://huggingface.co/mlx-community/Kokoro-82M-bf16/resolve/${model_revision}"
fetch "${model_base}/config.json" "${model_dir}/config.json"
fetch "${model_base}/kokoro-v1_0.safetensors" "${model_dir}/kokoro-v1_0.safetensors"
for voice in af_heart af_bella af_nicole bf_emma am_fenrir am_michael ff_siwis; do
    fetch "${model_base}/voices/${voice}.safetensors" "${model_dir}/voices/${voice}.safetensors"
done

g2p_base="https://huggingface.co/beshkenadze/kitten-tts-g2p/resolve/${g2p_revision}"
for filename in us_gold.json us_silver.json us_bart.safetensors us_bart_config.json; do
    fetch "${g2p_base}/${filename}" "${languages_dir}/en/${filename}"
done
fetch \
    "https://huggingface.co/beshkenadze/kokoro-ipa-lexicons/resolve/${lexicon_revision}/fr_lexicon.tsv" \
    "${languages_dir}/fr/fr_lexicon.tsv"

if [[ ! -s "${mlx_dir}/mlx.metallib" ]]; then
    mlx_wheel="${work_dir}/mlx-metal.whl"
    curl -fL --retry 3 --output "${mlx_wheel}" \
        "https://files.pythonhosted.org/packages/39/66/2313497fdbc7fbadf8e026c09366e3f049f9114e65ca4edc23cdb8699186/mlx_metal-0.31.1-py3-none-macosx_14_0_arm64.whl"
    actual_sha256="$(shasum -a 256 "${mlx_wheel}" | awk '{print $1}')"
    if [[ "${actual_sha256}" != "${mlx_metal_sha256}" ]]; then
        print -u2 "MLX Metal checksum mismatch"
        exit 1
    fi
    mkdir -p "${mlx_dir}"
    unzip -jo "${mlx_wheel}" mlx/lib/mlx.metallib -d "${mlx_dir}"
fi

print "Release assets are ready in ${assets_root}"
