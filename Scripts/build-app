#!/bin/zsh

set -euo pipefail

script_dir="${0:A:h}"
project_dir="${script_dir:h}"
assets_root="${READBACK_RELEASE_ASSETS_DIR:-${project_dir}/models}"
bundle_dir="${project_dir}/dist/ReadBack.app"
contents_dir="${bundle_dir}/Contents"
resources_dir="${contents_dir}/Resources"
skill_target="${resources_dir}/Skills/readback"
model_source="${assets_root}/Kokoro-82M-bf16"
model_target="${resources_dir}/Models/Kokoro-82M-bf16"
languages_source="${assets_root}/Languages"
codesign_identity="${READBACK_CODESIGN_IDENTITY:--}"
mlx_metallib="${assets_root}/MLX/0.31.1/mlx.metallib"

if [[ "${codesign_identity}" == "-" && "${READBACK_ALLOW_AD_HOC_SIGN:-}" != "1" ]]; then
    print -u2 "READBACK_CODESIGN_IDENTITY is not set. This would produce an" \
        "ad-hoc-signed, non-hardened-runtime build unsuitable for release."
    print -u2 "Set READBACK_CODESIGN_IDENTITY to a Developer ID, or set" \
        "READBACK_ALLOW_AD_HOC_SIGN=1 to build an ad-hoc local/dev build anyway."
    exit 1
fi

READBACK_RELEASE_ASSETS_DIR="${assets_root}" "${script_dir}/fetch-release-assets"

required_files=(
    "${model_source}/config.json"
    "${model_source}/kokoro-v1_0.safetensors"
    "${languages_source}/en/us_gold.json"
    "${languages_source}/en/us_silver.json"
    "${languages_source}/en/us_bart.safetensors"
    "${languages_source}/en/us_bart_config.json"
    "${languages_source}/fr/fr_lexicon.tsv"
    "${mlx_metallib}"
)
bundled_voices=(
    af_heart
    af_bella
    af_nicole
    bf_emma
    am_fenrir
    am_michael
    ff_siwis
)
for voice in "${bundled_voices[@]}"; do
    required_files+=("${model_source}/voices/${voice}.safetensors")
done
for file in "${required_files[@]}"; do
    if [[ ! -s "${file}" ]]; then
        print -u2 "Missing release asset: ${file}"
        exit 1
    fi
done

"${script_dir}/swiftw" build -c release --product readback
"${script_dir}/swiftw" build -c release --product readback-skill-client
"${script_dir}/swiftw" build -c release --product voicepipe

rm -rf "${bundle_dir}"
mkdir -p "${contents_dir}/MacOS"
mkdir -p "${resources_dir}/Languages" "${model_target}/voices"
mkdir -p "${resources_dir}/Skills"
cp -f "${project_dir}/.build/release/readback" "${contents_dir}/MacOS/readback"
cp -f "${project_dir}/.build/release/voicepipe" "${contents_dir}/MacOS/voicepipe"
cp -f "${mlx_metallib}" "${contents_dir}/MacOS/mlx.metallib"
cp -f "${project_dir}/App/Info.plist" "${contents_dir}/Info.plist"
"${script_dir}/stamp-info-plist" "${contents_dir}/Info.plist"
"${script_dir}/build-app-icon" \
    "${project_dir}/Assets/readback-wave-mark-1024.png" \
    "${resources_dir}/ReadBack.icns"
cp -f "${project_dir}/Assets/readback-wave-mark-monochrome-36.png" "${resources_dir}/ReadBackMenuBarTemplate.png"
cp -f "${project_dir}/Assets/readback-wave-mark-32.png" "${resources_dir}/ReadBack.png"
cp -R "${project_dir}/Skills/readback" "${resources_dir}/Skills/"
mkdir -p "${skill_target}/scripts"
cp -f "${project_dir}/.build/release/readback-skill-client" "${skill_target}/scripts/readback-skill-client"
chmod 755 "${skill_target}/scripts/readback-skill-client"
cp -f "${model_source}/config.json" "${model_source}/kokoro-v1_0.safetensors" "${model_target}/"
for voice in "${bundled_voices[@]}"; do
    cp -f "${model_source}/voices/${voice}.safetensors" "${model_target}/voices/"
done
cp -R "${languages_source}/en" "${languages_source}/fr" "${resources_dir}/Languages/"

nested_code=(
    "${contents_dir}/MacOS/mlx.metallib"
    "${contents_dir}/MacOS/voicepipe"
    "${skill_target}/scripts/readback-skill-client"
)
if [[ "${codesign_identity}" == "-" ]]; then
    for nested_path in "${nested_code[@]}"; do
        codesign --force --sign - "${nested_path}"
    done
    codesign --force --sign - "${bundle_dir}"
else
    for nested_path in "${nested_code[@]}"; do
        codesign --force --options runtime --timestamp --sign "${codesign_identity}" "${nested_path}"
    done
    codesign --force --options runtime --timestamp --sign "${codesign_identity}" "${bundle_dir}"
fi

print "Built ${bundle_dir}"
